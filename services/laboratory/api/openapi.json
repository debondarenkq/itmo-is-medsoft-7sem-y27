              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "LabOrderInput": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "maxLength": 512,
            "type": "string"
          },
          "patient_id": {
            "format": "uuid",
            "type": "string"
          },
          "test_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "patient_id",
          "test_ids"
        ],
        "type": "object"
      },
      "LabTest": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "active"
        ],
        "type": "object"
      },
      "LabTestInput": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^\\d{1,8}-\\d$",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "type": "object"
      },
